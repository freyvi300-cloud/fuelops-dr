generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Auth ─────────────────────────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Application Users ────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          Role      @default(EMPLOYEE)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]
}

enum Role {
  ADMIN
  EMPLOYEE
}

// ─── Customers ────────────────────────────────────────────────────────────────

model Customer {
  id                 String         @id @default(cuid())
  name               String
  phone              String?
  email              String?
  address            String?
  rnc                String?
  creditLimit        Decimal        @default(0) @db.Decimal(12, 2)
  currentBalance     Decimal        @default(0) @db.Decimal(12, 2)
  pendingGallons     Decimal        @default(0) @db.Decimal(10, 2)
  fuelPricePerGallon Decimal        @default(0) @db.Decimal(10, 4)
  status             CustomerStatus @default(ACTIVE)
  notes              String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  trucks   Truck[]
  supplies Supply[]
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
}

// ─── Trucks / Equipment ───────────────────────────────────────────────────────

model Truck {
  id         String      @id @default(cuid())
  customerId String
  code       String      @unique
  name       String
  plate      String?
  type       TruckType   @default(TRUCK)
  status     TruckStatus @default(ACTIVE)
  notes      String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  customer Customer @relation(fields: [customerId], references: [id])
  supplies Supply[]
}

enum TruckType {
  TRUCK
  TRAILER
  EQUIPMENT
  GENERATOR
  OTHER
}

enum TruckStatus {
  ACTIVE
  INACTIVE
}

// ─── Inventory Movements ──────────────────────────────────────────────────────

model InventoryMovement {
  id            String       @id @default(cuid())
  gallons       Decimal      @db.Decimal(10, 2)
  type          MovementType
  description   String?
  reference     String?
  costPerGallon Decimal?     @db.Decimal(10, 4)
  supplyId      String?      // links OUT movements to the originating supply
  movedAt       DateTime     @default(now())
  createdAt     DateTime     @default(now())
}

enum MovementType {
  IN
  OUT
  ADJUSTMENT
}

// ─── Supplies ─────────────────────────────────────────────────────────────────

model Supply {
  id             String      @id @default(cuid())
  customerId     String
  truckId        String?
  gallons        Decimal     @db.Decimal(10, 2)
  pricePerGallon Decimal     @db.Decimal(10, 4)
  total          Decimal     @db.Decimal(12, 2)
  paymentType    PaymentType @default(CREDIT)
  meterPhotoB64  String?     @db.Text   // TODO Phase 3: replace with meterPhotoUrl → Supabase Storage
  notes          String?
  suppliedAt     DateTime    @default(now())
  createdAt      DateTime    @default(now())

  customer Customer @relation(fields: [customerId], references: [id])
  truck    Truck?   @relation(fields: [truckId], references: [id])
}

enum PaymentType {
  CASH
  CREDIT
}
