generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Auth ─────────────────────────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Application Users ────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          Role      @default(EMPLOYEE)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]
}

enum Role {
  ADMIN
  EMPLOYEE
}

// ─── Customers ────────────────────────────────────────────────────────────────

model Customer {
  id                 String         @id @default(cuid())
  name               String
  phone              String?
  email              String?
  address            String?
  rnc                String?
  creditLimit        Decimal        @default(0) @db.Decimal(12, 2)
  currentBalance     Decimal        @default(0) @db.Decimal(12, 2)
  pendingGallons     Decimal        @default(0) @db.Decimal(10, 2)
  fuelPricePerGallon Decimal        @default(0) @db.Decimal(10, 4)
  status             CustomerStatus @default(ACTIVE)
  notes              String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  trucks   Truck[]
  supplies Supply[]
  invoices Invoice[]
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
}

// ─── Trucks / Equipment ───────────────────────────────────────────────────────

model Truck {
  id         String      @id @default(cuid())
  customerId String
  code       String      @unique
  name       String
  plate      String?
  type       TruckType   @default(TRUCK)
  status     TruckStatus @default(ACTIVE)
  notes      String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  customer Customer @relation(fields: [customerId], references: [id])
  supplies Supply[]
  invoices Invoice[]
}

enum TruckType {
  TRUCK
  TRAILER
  EQUIPMENT
  GENERATOR
  OTHER
}

enum TruckStatus {
  ACTIVE
  INACTIVE
}

// ─── Inventory Movements ──────────────────────────────────────────────────────

model InventoryMovement {
  id            String       @id @default(cuid())
  gallons       Decimal      @db.Decimal(10, 2)
  type          MovementType
  description   String?
  reference     String?
  costPerGallon Decimal?     @db.Decimal(10, 4)
  supplyId      String?
  movedAt       DateTime     @default(now())
  createdAt     DateTime     @default(now())
}

enum MovementType {
  IN
  OUT
  ADJUSTMENT
}

// ─── Supplies ─────────────────────────────────────────────────────────────────

model Supply {
  id             String      @id @default(cuid())
  customerId     String
  truckId        String?
  gallons        Decimal     @db.Decimal(10, 2)
  pricePerGallon Decimal     @db.Decimal(10, 4)
  total          Decimal     @db.Decimal(12, 2)
  paymentType    PaymentType @default(CREDIT)
  meterPhotoB64  String?     @db.Text
  notes          String?
  suppliedAt     DateTime    @default(now())
  createdAt      DateTime    @default(now())

  customer Customer @relation(fields: [customerId], references: [id])
  truck    Truck?   @relation(fields: [truckId], references: [id])
  invoice  Invoice?
}

enum PaymentType {
  CASH
  CREDIT
}

// ─── Invoices ─────────────────────────────────────────────────────────────────
// Architecture designed for: PDF, Print, Email, WhatsApp, QR Code, fiscal compliance.
// Future fields to add: pdfUrl, emailSentAt, whatsappSentAt, qrCode, signedBy, logoUrl.

model Invoice {
  id            String        @id @default(cuid())
  invoiceNumber String        @unique                  // INV-000001 — never reused
  supplyId      String        @unique                  // one invoice per supply (enforced at DB)
  customerId    String
  truckId       String?

  // Financial fields — ready for ITBIS (DR 18% VAT) and discounts
  subtotal      Decimal       @db.Decimal(12, 2)
  tax           Decimal       @default(0) @db.Decimal(12, 2)    // ITBIS — 0 until configured
  discount      Decimal       @default(0) @db.Decimal(12, 2)
  total         Decimal       @db.Decimal(12, 2)                // subtotal + tax - discount
  amountPaid    Decimal       @default(0) @db.Decimal(12, 2)
  balanceDue    Decimal       @db.Decimal(12, 2)                // total - amountPaid

  // Status & Dates
  status        InvoiceStatus @default(PENDING)
  issueDate     DateTime      @default(now())
  dueDate       DateTime?                               // null = immediate (CASH)

  // Metadata
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Relations
  supply        Supply        @relation(fields: [supplyId],    references: [id])
  customer      Customer      @relation(fields: [customerId],  references: [id])
  truck         Truck?        @relation(fields: [truckId],     references: [id])
}

enum InvoiceStatus {
  PENDING          // Created, awaiting payment
  PARTIALLY_PAID   // Payment received but balance > 0
  PAID             // Fully paid
  OVERDUE          // Past due date with balance remaining
  CANCELLED        // Voided
}
