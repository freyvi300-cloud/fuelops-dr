generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Auth ─────────────────────────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  @@unique([identifier, token])
}

// ─── Application Users ────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          Role      @default(EMPLOYEE)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts Account[]
  sessions Session[]
}

enum Role {
  ADMIN
  EMPLOYEE
}

// ─── Customers ────────────────────────────────────────────────────────────────

model Customer {
  id                 String            @id @default(cuid())
  name               String
  phone              String?
  email              String?
  address            String?
  rnc                String?
  creditLimit        Decimal           @default(0) @db.Decimal(12, 2)
  currentBalance     Decimal           @default(0) @db.Decimal(12, 2)
  pendingGallons     Decimal           @default(0) @db.Decimal(10, 2)
  // Pricing fields
  priceType          CustomerPriceType @default(FIXED)
  fuelPricePerGallon Decimal           @default(0) @db.Decimal(10, 4)  // used when priceType = FIXED
  priceDiscount      Decimal           @default(0) @db.Decimal(5, 2)   // % discount when priceType = DISCOUNT_PCT
  status             CustomerStatus    @default(ACTIVE)
  notes              String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  trucks   Truck[]
  supplies Supply[]
  invoices Invoice[]
  payments Payment[]
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
}

enum CustomerPriceType {
  FIXED         // uses fuelPricePerGallon directly
  DISCOUNT_PCT  // finalPrice = baseFuelPrice * (1 - priceDiscount / 100)
}

// ─── Trucks / Equipment ───────────────────────────────────────────────────────

model Truck {
  id         String      @id @default(cuid())
  customerId String
  code       String      @unique
  name       String
  plate      String?
  type       TruckType   @default(TRUCK)
  status     TruckStatus @default(ACTIVE)
  notes      String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  customer Customer @relation(fields: [customerId], references: [id])
  supplies Supply[]
  invoices Invoice[]
}

enum TruckType {
  TRUCK
  TRAILER
  EQUIPMENT
  GENERATOR
  OTHER
}

enum TruckStatus {
  ACTIVE
  INACTIVE
}

// ─── Inventory Movements ──────────────────────────────────────────────────────

model InventoryMovement {
  id            String       @id @default(cuid())
  gallons       Decimal      @db.Decimal(10, 2)
  type          MovementType
  description   String?
  reference     String?
  costPerGallon Decimal?     @db.Decimal(10, 4)
  supplyId      String?
  movedAt       DateTime     @default(now())
  createdAt     DateTime     @default(now())
}

enum MovementType {
  IN
  OUT
  ADJUSTMENT
}

// ─── Supplies ─────────────────────────────────────────────────────────────────

model Supply {
  id             String      @id @default(cuid())
  customerId     String
  truckId        String?
  gallons        Decimal     @db.Decimal(10, 2)
  pricePerGallon Decimal     @db.Decimal(10, 4)
  total          Decimal     @db.Decimal(12, 2)
  paymentType    PaymentType @default(CREDIT)
  meterPhotoB64  String?     @db.Text
  notes          String?
  suppliedAt     DateTime    @default(now())
  createdAt      DateTime    @default(now())
  customer Customer @relation(fields: [customerId], references: [id])
  truck    Truck?   @relation(fields: [truckId],    references: [id])
  invoice  Invoice?
}

enum PaymentType {
  CASH
  CREDIT
}

// ─── Invoices ─────────────────────────────────────────────────────────────────

model Invoice {
  id            String        @id @default(cuid())
  invoiceNumber String        @unique
  supplyId      String        @unique
  customerId    String
  truckId       String?
  subtotal      Decimal       @db.Decimal(12, 2)
  tax           Decimal       @default(0) @db.Decimal(12, 2)
  discount      Decimal       @default(0) @db.Decimal(12, 2)
  total         Decimal       @db.Decimal(12, 2)
  amountPaid    Decimal       @default(0) @db.Decimal(12, 2)
  balanceDue    Decimal       @db.Decimal(12, 2)
  status        InvoiceStatus @default(PENDING)
  issueDate     DateTime      @default(now())
  dueDate       DateTime?
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  supply   Supply   @relation(fields: [supplyId],   references: [id])
  customer Customer @relation(fields: [customerId], references: [id])
  truck    Truck?   @relation(fields: [truckId],    references: [id])
  payments Payment[]
}

enum InvoiceStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

// ─── Payments ─────────────────────────────────────────────────────────────────
// Architecture prepared for: PDF receipt, email, WhatsApp, bank reconciliation,
// refunds, auto-payments, multi-invoice allocation.
// Future fields: pdfUrl, emailSentAt, whatsappSentAt, reconciledAt, refundOf, createdBy.

model Payment {
  id            String        @id @default(cuid())
  paymentNumber String        @unique                    // PAY-000001 — never reused
  customerId    String
  invoiceId     String?                                  // optional — specific invoice
  amount        Decimal       @db.Decimal(12, 2)
  paymentMethod PaymentMethod
  reference     String?                                  // bank transfer #, check #, deposit slip
  notes         String?
  paymentDate   DateTime      @default(now())
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  customer Customer @relation(fields: [customerId], references: [id])
  invoice  Invoice? @relation(fields: [invoiceId],  references: [id])
}

enum PaymentMethod {
  CASH
  TRANSFER
  BANK_DEPOSIT
  CHECK
  OTHER
}

// ─── System Settings ──────────────────────────────────────────────────────────
// Singleton row — always upserted with id = "singleton".
// Admin configures: tank capacity, alert thresholds, business info.

model SystemSettings {
  id                 String   @id @default("singleton")
  businessName       String   @default("Empresa de Distribución de Diésel")
  rnc                String?
  phone              String?
  address            String?
  // Fuel / inventory
  tankCapacity       Decimal  @default(20000) @db.Decimal(10, 2)   // total tank in gallons
  alertRedGallons    Decimal  @default(2000)  @db.Decimal(10, 2)   // critical alert ≤ this
  alertYellowGallons Decimal  @default(4000)  @db.Decimal(10, 2)   // warning alert ≤ this
  defaultFuelPrice   Decimal  @default(0)     @db.Decimal(10, 4)   // default price per gallon
  // OCR settings
  ocrProvider        OcrProvider @default(MOCK)
  ocrEnabled         Boolean     @default(true)
  ocrMinConfidence   Int         @default(90)   // 0-100: min confidence to show auto-fill button
  // defaultFuelPrice (above) doubles as the "base fuel price" used to resolve
  // DISCOUNT_PCT customer pricing — see lib/pricing.ts
  updatedAt          DateTime    @updatedAt
}

enum OcrProvider {
  OPENAI
  GEMINI
  MOCK
}

// ─── WhatsApp Images ──────────────────────────────────────────────────────────
// Stores metadata for every image received via WhatsApp.
// The raw image is in Supabase Storage (bucket: whatsapp-images).
// Phase 3.2: this record will be linked to a Supply when OCR confirms the meter.

model WhatsAppImage {
  id          String   @id @default(cuid())
  mediaId     String   @unique            // WhatsApp media ID from Meta
  senderPhone String                      // wa_id — sender's phone (no +)
  senderName  String?                     // from contacts[] in webhook payload
  storageUrl  String                      // Supabase Storage public URL
  mimeType    String?                     // "image/jpeg", "image/png", etc.
  caption     String?                     // optional caption from sender
  createdAt   DateTime @default(now())

  // OCR result — Phase 3.2 (Gemini Vision analysis)
  ocrGallons     Decimal?  @db.Decimal(10, 2)  // meter reading in gallons, null if unreadable
  ocrConfidence  Int?                           // 0-100 confidence from Gemini
  ocrQuality     String?                        // "buena" | "regular" | "mala"
  ocrNotes       String?                        // brief observation from Gemini
  ocrProvider    String?                        // "gemini/gemini-2.0-flash"
  ocrRawText     String?   @db.Text             // full raw JSON from Gemini
  ocrProcessedAt DateTime?                      // when OCR ran
}
